[Unit]
Description=edge-infra independent Nowhere backup relay
Documentation=https://github.com/NodePassProject/Nowhere
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=edge-nowhere
Group=edge-nowhere
EnvironmentFile=/etc/edge-infra-nowhere/runtime.env
Environment=TMPDIR=/run/edge-infra-nowhere
Environment=XDG_RUNTIME_DIR=/run/edge-infra-nowhere
RuntimeDirectory=edge-infra-nowhere
RuntimeDirectoryMode=0700
ExecStart=/usr/local/lib/edge-infra-nowhere/nowhere ${NOWHERE_SERVICE_URL}
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
LimitNOFILE=65536
MemoryHigh=96M
MemoryMax=128M
CPUWeight=20
TasksMax=64
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/edge-infra-nowhere

[Install]
WantedBy=multi-user.target
