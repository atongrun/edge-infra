[Unit]
Description=Update edge-infra subscription traffic header
After=network-online.target vnstat.service nginx.service
Wants=network-online.target
Requires=vnstat.service nginx.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/edge-infra-traffic update
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/nginx/snippets/edge-infra-traffic /var/log/nginx/access.log
