{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "trojan",
      "tag": "trojan-in",
      "listen": "0.0.0.0",
      "listen_port": ${TROJAN_PORT},
      "users": [
        {
          "name": "personal",
          "password": "${TROJAN_PASSWORD}"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "${EDGE_DOMAIN}",
        "certificate_path": "/etc/letsencrypt/live/${CERT_NAME}/fullchain.pem",
        "key_path": "/etc/letsencrypt/live/${CERT_NAME}/privkey.pem"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
