# Reviewed upstream release assets for the independent overlays.
# Update the version and both architecture checksums together.
#
# Cloudflare XHTTP origin (Xray-core). Assets are Xray-linux-64.zip and
# Xray-linux-arm64-v8a.zip from the official XTLS/Xray-core release.
XRAY_VERSION=26.10.31
XRAY_AMD64_SHA256=e4bd9119f50ae7c41658b1abd0679ae06f98bd864a2907ff33f2f2cf7081b214
XRAY_ARM64_SHA256=1811c8f1da0c3b6dc707ebaf1c8390e987ba39859a8f0a7aadd8526157f2ec8d

# Mihomo is downloaded only to validate a candidate subscription before an
# atomic publish. It is not installed as a service.
MIHOMO_VERSION=1.19.33
MIHOMO_AMD64_SHA256=132f6f3edf9a65e62f04853aed3358472e0b2b7666daa8419edfa2ddf5bb6323
MIHOMO_ARM64_SHA256=ba408b317080ee265c46cb923a50018c1b82cbd708551cdd46a1e3e307396187

# The sing-box upgrade is a separate transaction and is not coupled to the
# Cloudflare overlay. Keep its pins independent of XRAY_* and MIHOMO_*.
UPGRADE_SING_BOX_VERSION=1.14.4
UPGRADE_SING_BOX_AMD64_SHA256=699a1b510aa4396b2176d32d1181920399ebf1e267835da6f3b598d0f7c24968
