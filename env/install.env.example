# Public, non-secret deployment inputs. Store the real file outside Git.
EDGE_DOMAIN=edge.example.com
SUB_DOMAIN=sub.example.com
PUBLIC_IPV4=203.0.113.10
ACME_EMAIL=admin@example.com

# Optional settings.
HOP_PORT_START=20000
HOP_PORT_END=20031
TROJAN_PORT=8443
FIREWALL_MODE=auto
# NETWORK_INTERFACE=eth0

# Exact provider quota in bytes: 500 GB (decimal). For 500 GiB use 536870912000.
TRAFFIC_TOTAL_BYTES=500000000000
# both = rx + tx; tx = VPS outbound only; rx = VPS inbound only.
TRAFFIC_BILLING_MODE=both
