# AnyTLS (TCP) + TUIC v5 (UDP) overlay. Copy to a root-only file and pass with
# scripts/extra-overlay.sh preflight|install --config FILE.
# Both inbounds reuse the existing edge certificate in place; the private key is
# read by sing-box from KEY_PATH and never copied.
EXTRA_SERVER=edge.example.com
EXTRA_SERVER_NAME=edge.example.com
CERT_PATH=/etc/letsencrypt/live/edge.example.com/fullchain.pem
KEY_PATH=/etc/letsencrypt/live/edge.example.com/privkey.pem
ANYTLS_PORT=8444
TUIC_PORT=8443
SUBSCRIPTION_FILE=/var/www/sub/REPLACE_WITH_SUBSCRIPTION.yaml
