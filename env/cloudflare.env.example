# Public, non-secret Cloudflare XHTTP overlay inputs.
# Copy to /root/edge-infra-cloudflare.env (0600) outside Git and edit there.
#
# Use a NEW dedicated hostname for the XHTTP origin. Never reuse or
# orange-cloud the existing edge, subscription, Reality, Trojan or HY2 names.
CF_HOSTNAME=backup.example.com

# Let's Encrypt lineage that covers CF_HOSTNAME. Full (strict) at Cloudflare
# requires a valid certificate for this hostname. The overlay does not edit DNS.
CF_CERT_NAME=backup.example.com

# Loopback-only Xray XHTTP origin. Nginx forwards CF_XHTTP_PATH here.
CF_XRAY_PORT=18080
CF_XHTTP_PATH=/replace-with-random-path

# Optional preferred Cloudflare anycast IP used as the Mihomo `server`.
# Leave empty to use CF_HOSTNAME. servername, XHTTP host and Host header always
# remain CF_HOSTNAME, even when this is set.
CF_PREFERRED_IP=

# The VLESS UUID and XHTTP path are generated/entered at install time and stored
# root-only under /var/lib/edge-infra-cloudflare. Do not commit real values.
# Example UUID shape only (generate, do not commit):
# CF_UUID=00000000-0000-4000-8000-000000000000
