# Optional independent Nowhere v3 backup relay. This file contains no secret.
# It is deliberately not read by install.sh or the base edge-infra services.
NOWHERE_PUBLIC_HOST=relay.example.com
NOWHERE_CERT_NAME=relay.example.com
NOWHERE_TCP_PORT=10443
NOWHERE_UDP_PORT=10443
NOWHERE_TRANSPORT_MEMORY_PROFILE=memory
FIREWALL_MODE=auto
